{
  "name": "TradePulse — Market alerts",
  "short_name": "TradePulse",
  "description": "Indian stock market news alerts, watchlist, charts and trading tools.",
  "id": "./",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0a0e14",
  "theme_color": "#0a0e14",
  "categories": ["finance", "news", "business"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "News", "url": "./#/news", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Watchlist", "url": "./#/watchlist", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Alerts", "url": "./#/alerts", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
